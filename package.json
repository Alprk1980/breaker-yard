{
  "name": "breaker-yard",
  "private": true,
  "version": "0.1.0",
  "description": "Systemic 2D orbital salvage simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "node --experimental-transform-types --no-warnings --import ./tools/register-ts.mjs tools/qwen-gen.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
